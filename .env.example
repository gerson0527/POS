# =============================================
# Configuración de Entorno — POS DIAN
# =============================================
# ⚠️  NO COMMITEAR CREDENCIALES REALES EN .env
# ⚠️  Las credenciales del proveedor de facturación electrónica
#     (Factus u otro) se configuran en /dashboard/settings
#     y se guardan en la tabla `tenant` de la base de datos,
#     NO en este archivo.
# =============================================

NODE_ENV=production
PORT=3000
APP_PORT=3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Autenticación
BETTER_AUTH_SECRET=change-this-to-a-long-random-string-in-production
BETTER_AUTH_URL=http://localhost:3000

# Clave de cifrado para secretos en BD (credenciales de facturación electrónica).
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ⚠️ NO rotar en producción sin plan de re-cifrado: los valores guardados quedarían ilegibles.
ENCRYPTION_KEY=change-this-to-a-long-random-base64url-string

# Base de Datos PostgreSQL
DATABASE_URL=postgresql://posuser:pospassword@postgres:5432/posdian
POSTGRES_USER=posuser
POSTGRES_PASSWORD=pospassword
POSTGRES_DB=posdian

# Email (opcional, sólo para notificaciones de bienvenida)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=POS DIAN <notificaciones@posdian.co>

# =============================================
# DIAN / Facturación electrónica
# =============================================
# NO poner credenciales reales aquí. Para configurar
# el proveedor de facturación ve a /dashboard/settings
# y usa la pestaña "FACTURACIÓN ELECTRÓNICA (PROVEEDOR)".
#
# Si aún usas DIAN directo (no recomendado), descomenta y llena:
# DIAN_SOFTWARE_ID=
# DIAN_SOFTWARE_PIN=
# DIAN_CERTIFICATE=base64-pkcs12-certificate
# DIAN_CERTIFICATE_PASSWORD=
# DIAN_ENVIRONMENT=2


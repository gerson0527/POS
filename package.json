{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run db:doctor -- --soft",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "tauri:dev": "npx @tauri-apps/cli dev",
    "tauri:build": "npx @tauri-apps/cli build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run test/integration",
    "db:seed": "npx dotenv -e .env -- npx tsx scripts/seed.ts",
    "db:generate": "npx dotenv -e .env -- drizzle-kit generate",
    "db:migrate": "npx dotenv -e .env -- npx tsx scripts/db-migrate.ts",
    "db:migrate:deploy": "tsx scripts/db-migrate.ts",
    "db:push": "npx dotenv -e .env -- drizzle-kit push",
    "db:studio": "npx dotenv -e .env -- drizzle-kit studio",
    "db:doctor": "npx dotenv -e .env -- npx tsx scripts/db-doctor.ts",
    "assistant:poll": "npx dotenv -e .env.local -e .env -- npx tsx scripts/telegram-poll.ts"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "@sparticuz/chromium": "^153.0.0",
    "better-auth": "^1.6.25",
    "clsx": "^2.1.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "motion": "^14.4.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "puppeteer": "^25.4.0",
    "qrcode.react": "^4.2.0",
    "react": "^19",
    "react-dom": "^19",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "5.7.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}

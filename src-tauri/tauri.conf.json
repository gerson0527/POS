{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "POS Retail Enterprise DIAN",
  "version": "3.0.3",
  "identifier": "com.posretail.enterprise",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "node scripts/prepare-tauri-dist.js --prepare-dev && npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "POS Retail Enterprise - Sistema de Punto de Venta & DIAN",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "backend/": "backend/",
      "postgres-bundle/": "postgres/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
